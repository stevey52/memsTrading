# =====================================================================
# SOLANA NETWORK & WALLET CONFIGURATION
# =====================================================================
# Recommended: Get a free RPC URL from https://helius.dev or https://quicknode.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Private key: Can be Base58 string (Phantom/Solflare) OR JSON byte array [12, 43, ...]
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# =====================================================================
# TRADE & SCALPING PARAMETERS
# =====================================================================
# Amount of SOL to invest per trade
TRADE_AMOUNT_SOL=0.02

# Slippage tolerance in basis points (500 = 5%, 800 = 8%, 1000 = 10%)
SLIPPAGE_BPS=800

# Scalp Exit Conditions
TAKE_PROFIT_PCT=25.0
STOP_LOSS_PCT=10.0

# Trailing Stop Settings
TRAILING_STOP_ENABLED=True
TRAILING_TRIGGER_PCT=8.0
TRAILING_DROP_PCT=3.5

# Breakeven Protection (Locks stop loss at +0.5% once peak reaches +5%)
BREAKEVEN_PROTECTION_ENABLED=True
BREAKEVEN_TRIGGER_PCT=5.0

# Maximum hold duration before exiting stagnant trades (seconds)
MAX_HOLD_SECONDS=240

# =====================================================================
# SCANNER & SAFETY FILTER SETTINGS
# =====================================================================
# Minimum liquidity pool depth in USD to avoid high price impact
MIN_LIQUIDITY_USD=12000

# Minimum 5-minute volume in USD
MIN_5M_VOLUME_USD=8000

# Minimum ratio of Buys vs Sells in last 5m (e.g. 1.3 means 30% more buys than sells)
MIN_BUY_SELL_RATIO=1.3

# Maximum RugCheck risk score (0-500 = safe/low risk, >500 = danger)
MAX_RUGCHECK_SCORE=500

# RugCheck API failure policy (False = reject if API fails or unindexed; True = allow with caution)
RUGCHECK_FAIL_OPEN=False

# Scanner loop delay (seconds)
SCAN_INTERVAL_SECONDS=10

# =====================================================================
# PUMP.FUN LIVE WEBSOCKET SETTINGS
# =====================================================================
# Minimum SOL the creator must have purchased on launch (avoids 0 SOL abandoned scams)
PUMP_MIN_DEV_BUY_SOL=0.5
PUMP_MAX_DEV_BUY_SOL=6.0

# Minimum Market Cap in SOL to avoid 0-second launch deaths (e.g. 30.0 SOL is initial curve)
PUMP_MIN_MARKET_CAP_SOL=30.0

# =====================================================================
# SOCIAL MEDIA & OSINT VERIFICATION SETTINGS
# =====================================================================
# Enforce that tokens have verified social links attached (Twitter/X or Telegram)
REQUIRE_SOCIALS=True

# Strictly require a valid Twitter/X profile link (e.g. https://x.com/token)
REQUIRE_TWITTER=True

# Strictly require a valid Telegram community link (e.g. https://t.me/token)
REQUIRE_TELEGRAM=False

# Strictly require a project website
REQUIRE_WEBSITE=False

# =====================================================================
# ON-CHAIN ANTI-CABAL & ANTI-BUNDLE FILTERS
# =====================================================================
# Maximum % of total supply any single non-bonding-curve wallet can hold (default 10%)
MAX_DEV_HOLDING_PCT=10.0

# Maximum combined % of supply the top 10 non-curve holders can hold (default 25%)
MAX_TOP10_NON_CURVE_PCT=25.0

# =====================================================================
# AI AGENT COUNCIL SETTINGS (Google Gemini 2.5 Flash)
# =====================================================================
# Free API key from Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Enable autonomous Narrative & Forensic AI agent verification
AGENT_EVAL_ENABLED=True

# Minimum composite Alpha Score (0-100) required to authorize a trade (default 75.0)
MIN_AGENT_ALPHA_SCORE=75.0

# Allow the Trade Strategist Agent to suggest dynamic Take-Profit and Stop-Loss targets
AGENT_DYNAMIC_TP_SL=True

# Rate Limiting & Cooldown (Strictly <= 15 RPM ceiling)
AGENT_MAX_RPM=12
AGENT_COOLDOWN_SECONDS=25
AGENT_FAIL_OPEN=False

# =====================================================================
# MULTI-TIER MOONBAG & MOONSHOT RUNNER ENGINE (200% - 1000%+)
# =====================================================================
MOONBAG_ENABLED=True
TIER1_TP_PCT=80.0
TIER1_SELL_PCT=50.0
TIER2_TP_PCT=250.0
TIER2_SELL_PCT=25.0
MOONBAG_TRAILING_DROP_PCT=22.0
RUNNER_HOLD_SECONDS=1200
RUNNER_MIN_ALPHA_SCORE=85.0

# Pre-Graduation Raydium Migration Tracker
PUMP_PRE_GRADUATION_TRACKING=True
PUMP_GRADUATION_MIN_SOL=65.0
PUMP_GRADUATION_MAX_SOL=84.0

# =====================================================================
# QUANTITATIVE ML ALPHA ENGINE (XGBoost, GBDT, & Vector Clone Auditor)
# =====================================================================
ML_FILTER_ENABLED=True
MAX_RUG_PROBABILITY=0.45
MIN_ML_ALPHA_SCORE=60.0
MAX_CLONE_RISK=70.0
ML_AUTO_RETRAIN=True

# =====================================================================
# WEB TERMINAL & DASHBOARD CONFIGURATION
# =====================================================================
APP_URL=http://127.0.0.1:5000



